{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": [
      "es2023",
      "dom"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "test",
    "codegen"
  ]
}
