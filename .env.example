# Anuvritti - 12-factor configuration.
# Copy to .env for local development. NEVER commit a filled-in .env (PRD 44).

# --- runtime -----------------------------------------------------------------
ANUVRITTI_ENV=development            # development | test | production
ANUVRITTI_LOG_LEVEL=INFO

# --- storage -----------------------------------------------------------------
ANUVRITTI_DB_PATH=var/anuvritti.db
ANUVRITTI_MEDIA_DIR=var/media

# Fernet key for media encryption at rest. REQUIRED in production.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANUVRITTI_MEDIA_KEY=

# --- transport ---------------------------------------------------------------
ANUVRITTI_TLS_REQUIRED=true          # cannot be false in production

# --- media limits ------------------------------------------------------------
ANUVRITTI_MAX_MEDIA_BYTES=26214400   # 25 MiB

# --- return engine (PRD 14, 8.5) ---------------------------------------------
ANUVRITTI_MAX_SUGGESTIONS_PER_DAY=3  # anti-metric: keep this LOW
ANUVRITTI_SNOOZE_COOLDOWN_DAYS=30    # "maybe later" must mean later, not tomorrow
ANUVRITTI_SUGGESTION_THRESHOLD=0.45
ANUVRITTI_MATURATION_HORIZON_DAYS=180
ANUVRITTI_MIN_DAYS_BEFORE_RETURN=7    # nothing saved this week is "brought back"

# --- orchestrator (scripts/orchestrate.sh) -----------------------------------
MAX_RETRIES=3
TEST_CMD=pytest
AUTO_MODE=false
PRD_PATH=docs/PRD.md
