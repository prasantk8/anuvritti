{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    // `test/` runs under `node --test`, so the tests import `node:test`, `node:assert` and
    // `node:fs`. Named rather than left to the automatic scan: under `moduleResolution:
    // bundler` with expo's `react-native` custom condition, @types/node is on disk and not
    // otherwise loaded, and every test file then fails to compile.
    "types": ["node", "react"],
    "paths": {
      "@anuvritti/client": ["../../packages/client/src/index.ts"],
      "@anuvritti/world": ["../../packages/world/src/index.ts"]
    }
  },
  "include": ["app", "src", "test", "*.ts"]
}
