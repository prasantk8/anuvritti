# What belongs in this repository: the logic, the tests, the contracts and the docs.
# What does not: anything a build step can produce again, and anything a family saved.

# --- Generated by packages/world. `make world` rebuilds it, and tests/design refuses
#     to run against a stale copy, so committing it would only create a second truth.
packages/world/dist/
node_modules/

# --- Native projects, written by `expo prebuild` from app.json. Committing them would
#     make app.json advisory: a plugin change would stop taking effect and nobody would
#     know why. `packages/client/src/generated/` is deliberately NOT here - it is small,
#     it is read during review, and tests/design fails if it drifts from the contract.
apps/*/ios/
apps/*/android/
apps/*/.expo/
apps/*/dist/
*.tsbuildinfo

# --- A family's own material. Never, under any circumstances, in version control.
# `var/` is the runtime directory, and ANUVRITTI_MEDIA_DIR lives inside it. Do not
# add a bare `media/` rule here: it matches at any depth and silently swallows
# src/anuvritti/adapters/media, which is source code.
var/
*.db
*.db-wal
*.db-shm
*.mp4
*.webm
*.mov
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.opus

# --- Secrets
.env
.env.*
!.env.example

# --- Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# --- Worktrees. `git worktree add .claude/worktrees/task-NNN` puts a second checkout
#     inside the first, and git will happily offer to commit that checkout's own
#     .venv, .mypy_cache and .coverage into this one. One task per chat means these
#     appear routinely; none of them is source.
.claude/worktrees/

# --- macOS
.DS_Store
